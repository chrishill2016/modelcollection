@inherits LayoutComponentBase
@* Created up front so it sees every page change. *@
@inject AppNavigation AppNav
@inject ThemeService Themes
@implements IDisposable

<MudThemeProvider @ref="_themeProvider" Theme="AppTheme.Theme" IsDarkMode="_isDark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<AppStartup />

<MudLayout>
    <MudAppBar Elevation="1" Dense="false">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" aria-label="Menu" />
        <MudIcon Icon="@Icons.Material.Filled.DirectionsCar" Class="ml-1 mr-2" />
        <MudText Typo="Typo.h6" Class="app-title">Model Cars</MudText>
        <MudSpacer />
        <SyncStatusIndicator />
        <AccountButton />
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Variant="DrawerVariant.Responsive" Elevation="1">
        <MudNavMenu>
            <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.GridView">Collection</MudNavLink>
            <MudNavLink Href="cars/new" Icon="@Icons.Material.Filled.AddCircleOutline">Add a car</MudNavLink>
            <MudNavLink Href="cars/quick" Icon="@Icons.Material.Filled.PhotoCamera">Quick add</MudNavLink>
            <MudNavLink Href="stats" Icon="@Icons.Material.Filled.Insights">Stats</MudNavLink>
            @* Backup page (/backup) is hidden from the menu for now. *@
            <MudNavLink Href="settings" Icon="@Icons.Material.Filled.Settings">Settings</MudNavLink>
        </MudNavMenu>
        <MudSpacer />
        <div class="pa-4">
            <MudText Typo="Typo.caption" Class="mud-text-secondary">Version @AppInfo.Version</MudText>
        </div>
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-4">
            @Body
        </MudContainer>
        <footer class="app-footer">
            <MudText Typo="Typo.caption" Class="mud-text-secondary">Model Cars v@(AppInfo.Version)</MudText>
        </footer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private MudThemeProvider _themeProvider = default!;
    private bool _isDark;
    private bool _systemIsDark;

    protected override void OnInitialized()
    {
        // The saved theme was loaded in Program.cs before the app started rendering.
        Themes.Changed += OnThemeChanged;
        _isDark = Themes.IsDark(_systemIsDark);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _systemIsDark = await _themeProvider.GetSystemDarkModeAsync();
        await _themeProvider.WatchSystemDarkModeAsync(dark =>
        {
            _systemIsDark = dark;
            return InvokeAsync(UpdateThemeAsync);
        });
        await UpdateThemeAsync();
    }

    private void OnThemeChanged() => InvokeAsync(UpdateThemeAsync);

    private async Task UpdateThemeAsync()
    {
        _isDark = Themes.IsDark(_systemIsDark);
        await Themes.ApplyToPageAsync(_isDark);
        StateHasChanged();
    }

    public void Dispose() => Themes.Changed -= OnThemeChanged;

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
}
