@page "/cars/{Id}"
@implements IDisposable
@inject ILocalStore Store
@inject IPhotoService Photos
@inject IRemoteStore Remote
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

<PageTitle>@(_car?.DisplayName ?? "Car") – Model Cars</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="./" aria-label="Back to collection" />
    <MudText Typo="Typo.h5" HtmlTag="h1">@(_car?.DisplayName ?? "Car")</MudText>
    <MudSpacer />
    @if (_car is not null)
    {
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Edit" Href="@($"cars/{Id}/edit")">Edit</MudButton>
        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="Delete" aria-label="Delete car" />
    }
</MudStack>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_car is null)
{
    <MudAlert Severity="Severity.Warning">That car couldn't be found. It may have been deleted.</MudAlert>
}
else
{
    <MudGrid Spacing="4">
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-3" Outlined="true">
                <MudText Typo="Typo.h6" Class="mb-2">Photos</MudText>
                <div class="mb-3">
                    <PhotoPicker Busy="_uploading" FilesSelected="AddPhotos" />
                </div>
                @if (_photos.Count == 0)
                {
                    <div class="car-photo-placeholder" style="border-radius: 4px">
                        <MudStack AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Material.Filled.PhotoCamera" Size="Size.Large" />
                            <MudText Typo="Typo.body2">No photos on this device yet</MudText>
                        </MudStack>
                    </div>
                }
                else
                {
                    @* Shows the thumbnail until the full-size image has loaded (or if it can't be fetched offline). *@
                    <img src="@(_selectedFull ?? _selected?.DataUrl)" alt="@_car.DisplayName" style="width: 100%; border-radius: 4px" class="mb-2" data-testid="main-photo" />
                    @if (_selected is not null && _selectedFull is null && !_loadingFull)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-2">Full-size photo will load when you're online.</MudText>
                    }
                    @if (_photos.Count > 1 && _selected is { } current)
                    {
                        var index = _photos.FindIndex(p => p.Id == current.Id);
                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2" data-testid="photo-actions">
                            <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Disabled="index <= 0" OnClick="() => MovePhoto(current, -1)" aria-label="Move photo left" />
                            <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Disabled="index >= _photos.Count - 1" OnClick="() => MovePhoto(current, 1)" aria-label="Move photo right" />
                            <MudSpacer />
                            @if (index == 0)
                            {
                                <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.Star" Color="Color.Primary">Cover photo</MudChip>
                            }
                            else
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.StarOutline" OnClick="() => MakeCover(current)">Make cover</MudButton>
                            }
                        </MudStack>
                    }
                    <div class="photo-gallery">
                        @foreach (var photo in _photos)
                        {
                            <div style="position: relative" @key="photo.Id">
                                <img src="@photo.DataUrl" alt="" @onclick="() => SelectAsync(photo)" data-photo-id="@photo.Id"
                                     style="@(photo.Id == _selected?.Id ? "outline: 2px solid var(--mud-palette-primary)" : "")" />
                                @if (photo == _photos[0] && _photos.Count > 1)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" Color="Color.Primary" Title="Cover photo"
                                             Style="position:absolute; top:4px; left:4px; background: rgba(0,0,0,.5); border-radius: 50%" />
                                }
                                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Style="position:absolute; top:2px; right:2px; background: rgba(0,0,0,.5)"
                                               OnClick="() => DeletePhoto(photo)" aria-label="Delete photo" />
                            </div>
                        }
                    </div>
                }
                <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2 d-block">
                    @(Remote.SupportsPhotos ? "Photos sync to everyone sharing the collection." : "Photos are kept on this device and included in backups.")
                </MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-3" Outlined="true">
                <MudSimpleTable Dense="true" Elevation="0">
                    <tbody>
                        <DetailRow Label="Make" Value="@_car.Make" />
                        <DetailRow Label="Model" Value="@_car.Model" />
                        <DetailRow Label="Year" Value="@_car.Year?.ToString()" />
                        <DetailRow Label="Brand" Value="@_car.Manufacturer" />
                        <DetailRow Label="Scale" Value="@_car.Scale" />
                        <DetailRow Label="Colour" Value="@_car.Colour" />
                        <DetailRow Label="Condition" Value="@_car.Condition.ToLabel()" />
                        <DetailRow Label="Boxed" Value="@(_car.HasBox ? "Yes" : "No")" />
                        <DetailRow Label="Bought" Value="@_car.PurchaseDate?.ToString("d MMM yyyy")" />
                        <DetailRow Label="Price paid" Value="@Money(_car.PurchasePrice)" />
                        <DetailRow Label="Estimated value" Value="@Money(_car.EstimatedValue)" />
                        <DetailRow Label="Kept in" Value="@_car.Location" />
                    </tbody>
                </MudSimpleTable>
                @if (_car.Tags.Count > 0)
                {
                    <div class="mt-3">
                        @foreach (var tag in _car.Tags)
                        {
                            <MudChip T="string" Size="Size.Small">@tag</MudChip>
                        }
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(_car.Notes))
                {
                    <MudText Typo="Typo.subtitle2" Class="mt-3">Notes</MudText>
                    <MudText Typo="Typo.body2" Style="white-space: pre-wrap">@_car.Notes</MudText>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter] public string Id { get; set; } = "";

    private ModelCar? _car;
    private List<CarPhoto> _photos = [];
    private CarPhoto? _selected;
    private string? _selectedFull;
    private bool _loadingFull;
    private bool _loading = true;
    private bool _uploading;

    protected override void OnInitialized() => Store.Changed += OnStoreChanged;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var car = await Store.GetCarAsync(Id);
        _car = car is { IsDeleted: false } ? car : null;
        _photos = _car is null ? [] : PhotoOrdering.Sort(await Store.GetThumbnailsAsync(Id), _car.PhotoOrder).ToList();
        await SelectAsync(_photos.FirstOrDefault(p => p.Id == _selected?.Id) ?? _photos.FirstOrDefault());
        _loading = false;
    }

    private async Task AddPhotos(IReadOnlyList<IBrowserFile> files)
    {
        if (files.Count == 0)
        {
            return;
        }

        _uploading = true;
        StateHasChanged();
        CarPhoto? last = null;
        var failed = 0;
        foreach (var file in files)
        {
            try
            {
                last = await Photos.AddPhotoAsync(Id, file);
            }
            catch (Exception)
            {
                failed++;
            }
        }

        await LoadAsync();
        if (_photos.FirstOrDefault(p => p.Id == last?.Id) is { } added)
        {
            await SelectAsync(added);
        }

        _uploading = false;

        if (failed > 0)
        {
            Snackbar.Add(failed == files.Count ? "Couldn't add that photo. Is it an image?" : $"{failed} of {files.Count} photos couldn't be added", Severity.Error);
        }
    }

    private Task MakeCover(CarPhoto photo) => SavePhotoOrder(PhotoOrdering.MakeCover(_photos, photo.Id));

    private Task MovePhoto(CarPhoto photo, int direction) => SavePhotoOrder(PhotoOrdering.Move(_photos, photo.Id, direction));

    // Saved on the car so the order syncs like any other edit; the Changed event reloads the page.
    private async Task SavePhotoOrder(IReadOnlyList<string> order)
    {
        if (_car is not null)
        {
            await Store.SaveCarAsync(_car with { PhotoOrder = order });
        }
    }

    private async Task SelectAsync(CarPhoto? photo)
    {
        if (photo?.Id == _selected?.Id && _selectedFull is not null)
        {
            return;
        }

        _selected = photo;
        _selectedFull = null;
        if (photo is null)
        {
            return;
        }

        _loadingFull = true;
        StateHasChanged();
        var full = await Photos.GetFullImageAsync(photo);
        // Ignore the result if another photo was picked while this one was loading.
        if (_selected?.Id == photo.Id)
        {
            _selectedFull = full;
            _loadingFull = false;
        }
    }

    private async Task DeletePhoto(CarPhoto photo)
    {
        if (await Dialogs.ShowMessageBoxAsync("Delete photo?", Remote.SupportsPhotos ? "This photo will be removed for everyone sharing the collection." : "This photo will be removed from this device.", yesText: "Delete", cancelText: "Cancel") == true)
        {
            await Store.DeletePhotoAsync(photo.Id);
        }
    }

    private async Task Delete()
    {
        if (await Dialogs.ShowMessageBoxAsync("Delete car?", $"Remove {_car!.DisplayName} from the collection? This also deletes it for everyone you share with.",
                yesText: "Delete", cancelText: "Cancel") == true)
        {
            await Store.DeleteCarAsync(Id);
            Snackbar.Add("Car deleted", Severity.Info);
            Nav.NavigateTo("");
        }
    }

    private static string? Money(decimal? value) => value?.ToString("£#,##0.00");

    private void OnStoreChanged() => InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose() => Store.Changed -= OnStoreChanged;
}
